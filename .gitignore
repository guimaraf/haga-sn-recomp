# Generated recompiler output — derived from a copyrighted ROM. Never commit.
/src/gen/
/recomp/funcs.h

# The ROM itself, in every form. Players supply their own.
*.sfc
*.smc
*.srm

# Build trees and packaged output
/build/
/build-*/
/dist/
/saves/

# Framework checkouts stay as submodules under modules/; these root copies are
# local workspace imports and contain machine-local build artifacts.
/recomp-ui/
/snesrecomp/

# Shared dependency checkouts are supplied by the parent workspace and stay local.
/dependences/SDL3/
/dependences/libjuice-1.7.2/
/dependences/lua-5.4.9/

# Local probe output that names paths on one machine
/rom_probe.json

# Launcher/runtime state written beside the executable
/rom.cfg
/keybinds.ini
/config.ini
/input.ini
last_run_report.json

.DS_Store
.tmp/
validation/
